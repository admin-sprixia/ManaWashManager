// This schema is the source of truth for TypeScript types (via `prisma generate`).
// The database itself is built by the numbered SQL files in apps/api/migrations (applied with
// `wrangler d1 migrations apply`, not `prisma migrate`); apps/api/schema.sql is the readable
// snapshot of the result. Keep this file in sync with schema.sql — models, columns, relations
// and indexes. CHECK constraints, triggers and partial indexes live only in the SQL.
//
// Naming convention (see the app build plan's "Naming conventions" section):
//   - Prisma models: PascalCase singular, mapped to a snake_case plural table via @@map.
//   - Columns: snake_case via @map, with `_id` for foreign keys and `_at` for timestamps.
//   - Money: stored as an Int in paise (1 rupee = 100 paise) to avoid float rounding.
//
// Multi-shop: every model except Shop, PlatformSetting, SignupCode, RateLimit, BillingEvent,
// CustomerAccount and the business-level service network models (bottom of this file) has `shopId`. Queries never set it by
// hand — the shop-scoped client (src/client.ts) adds it to every read and write. Its
// `@default("")` only exists so create inputs don't demand it; the database has no default, so
// a row that somehow skipped the scoped client fails to insert instead of landing shopless.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One car wash on the platform. Plan: trial | active | past_due | read_only | cancelled | free.
model Shop {
  id               String    @id @default(uuid())
  /// 6-digit shop ID staff type to ask to join. Not a secret — the owner still approves.
  code             String    @unique
  name             String
  city             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  /// Listed in the Mana Wash app. Set by Sprixia for MANA's own branches, never by an owner.
  inCustomerApp    Boolean   @default(false) @map("in_customer_app")
  /// The hub, and how far from it the branch washes (null = only its service areas).
  latitude         Float?
  longitude        Float?
  serviceRadiusKm  Float?    @map("service_radius_km")
  /// Contact details and opening hours shown in the app. Hours are "HH:MM" IST, both or neither.
  address          String?
  contactPhone     String?   @map("contact_phone")
  opensAt          String?   @map("opens_at")
  closesAt         String?   @map("closes_at")
  /// Day of the week the branch is closed: Sunday = 0 … Saturday = 6.
  weeklyOff        Int?      @map("weekly_off")
  /// Every day it closes, "0,6" (Sunday = 0); weeklyOff is the first of them, for older apps.
  weeklyOffDays    String?   @map("weekly_off_days")
  /// The business this branch belongs to (service network), and how it is priced: its price book
  /// (null = the business's default) and zone (null = none).
  businessId       String?   @map("business_id")
  priceBookId      String?   @map("price_book_id")
  priceZoneId      String?   @map("price_zone_id")
  /// The business catalog_version this branch's menu was last generated from.
  menuVersion      Int       @default(0) @map("menu_version")
  /// Set only by Mana Wash HQ: "active" | "paused" | "closed" (BranchStatus in @mana/domain).
  status           String    @default("active")
  statusReason     String?   @map("status_reason")
  statusChangedAt  DateTime? @map("status_changed_at")
  /// Its town (the code's 3 letters, for good) and pincode, from opening it.
  townId           String?   @map("town_id")
  pincode          String?
  /// What the branch offers: head office allows (its agreement), the owner switches on (now).
  allowHub         Boolean   @default(true) @map("allow_hub")
  allowCommunity   Boolean   @default(true) @map("allow_community")
  allowDoorstep    Boolean   @default(true) @map("allow_doorstep")
  offerHub         Boolean   @default(true) @map("offer_hub")
  offerCommunity   Boolean   @default(false) @map("offer_community")
  offerDoorstep    Boolean   @default(false) @map("offer_doorstep")

  @@index([businessId])
  @@map("shops")
}

/// A phone that proved it holds a number with a WhatsApp code; the PIN works only on these.
model TrustedDevice {
  id         String   @id @default(uuid())
  phone      String
  deviceHash String   @map("device_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  /// Make and model, shown in More → Your phones.
  label      String?
  /// When the right PIN was last used here; seniors can only self-reset on such a phone.
  pinConfirmedAt DateTime? @map("pin_confirmed_at")

  @@unique([phone, deviceHash])
  @@map("trusted_devices")
}

/// A PIN reset: whose, who did it and from which branch (null = Sprixia support).
model PinReset {
  id        String   @id @default(uuid())
  phone     String
  shopId    String?  @map("shop_id")
  byPhone   String?  @map("by_phone")
  byLabel   String   @map("by_label")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("pin_resets")
}

/// Every status HQ has set for a branch, who set it and why.
model BranchStatusEvent {
  id             String   @id @default(uuid())
  shopId         String   @map("shop_id")
  status         String
  reason         String?
  changedByPhone String   @map("changed_by_phone")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([shopId, createdAt])
  @@map("branch_status_events")
}

/// A charge from the software subscriptions shops paid before migration 0012. Kept for the record.
model BillingPayment {
  id             String    @id // Razorpay payment id
  shopId         String    @default("") @map("shop_id")
  subscriptionId String    @map("subscription_id")
  amountPaise    Int       @map("amount_paise")
  status         String // "captured" | "failed" | "refunded"
  method         String?
  periodEnd      DateTime? @map("period_end")
  paidAt         DateTime  @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([shopId, id])
  @@index([shopId, paidAt])
  @@map("billing_payments")
}

/// Razorpay webhook deliveries already handled, so retries are no-ops. Platform-level.
model BillingEvent {
  id         String   @id
  event      String
  shopId     String?  @map("shop_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("billing_events")
}

/// Settings for the platform itself (Sprixia), not any one shop — e.g. the error-alert timer.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("platform_settings")
}

model User {
  id                String    @id @default(uuid())
  shopId            String    @default("") @map("shop_id")
  name              String
  /// Unique per shop among users who aren't removed — a partial index in schema.sql, which Prisma
  /// can't express. Someone working at several branches has one row per shop, all sharing one PIN.
  phone             String
  role              String    @default("staff") // "owner" | "manager" | "staff"
  active            Boolean   @default(true)
  pinHash           String?   @map("pin_hash")
  pinFailedAttempts Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil    DateTime? @map("pin_locked_until")
  /// In every session token; bumping it signs out all phones holding an older token.
  sessionVersion    Int       @default(0) @map("session_version")
  /// Removed from the team: the row stays for history, the phone number is free for another shop.
  removedAt         DateTime? @map("removed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  /// Length of the current PIN (owners and managers need 6), and when it was chosen.
  pinDigits         Int?      @map("pin_digits")
  pinSetAt          DateTime? @map("pin_set_at")
  /// Locks in a row; each lasts longer. Back to 0 after a right or new PIN.
  pinLockCount      Int       @default(0) @map("pin_lock_count")

  jobsCreated        Job[]             @relation("JobCreatedBy")
  jobsPaid           Job[]             @relation("JobPaidBy")
  jobsVoided         Job[]             @relation("JobVoidedBy")
  jobEvents          JobEvent[]
  expenses           Expense[]         @relation("ExpenseCreatedBy")
  expensesVoided     Expense[]         @relation("ExpenseVoidedBy")
  expenseEdits       ExpenseEdit[]     @relation("ExpenseEditedBy")
  couponsIssued      Coupon[]          @relation("CouponIssuedBy")
  couponsRedeemed    Coupon[]          @relation("CouponRedeemedBy")
  washes             JobWasher[]       @relation("JobWasher")
  washersAssigned    JobWasher[]       @relation("JobWasherAssignedBy")
  sales              JobSeller[]       @relation("JobSeller")
  sellersAssigned    JobSeller[]       @relation("JobSellerAssignedBy")
  attendance         Attendance[]      @relation("AttendanceUser")
  attendanceMarked   Attendance[]      @relation("AttendanceMarkedBy")
  photosTaken        JobPhoto[]        @relation("JobPhotoTakenBy")
  photosDeleted      JobPhoto[]        @relation("JobPhotoDeletedBy")
  referralsLogged    Referral[]
  cashFloatsSet      CashDay[]         @relation("CashDayFloatSetBy")
  cashDaysClosed     CashDay[]         @relation("CashDayClosedBy")
  cashDaysReopened   CashDay[]         @relation("CashDayReopenedBy")
  loginCodes         LoginCode[]
  stockItems         StockItem[]       @relation("StockItemCreatedBy")
  stockMoves         StockMove[]       @relation("StockMoveCreatedBy")
  settingsUpdated    AppSetting[]      @relation("AppSettingUpdatedBy")
  remindersSent      VehicleReminder[] @relation("VehicleReminderRemindedBy")
  remindersDismissed VehicleReminder[] @relation("VehicleReminderDismissedBy")
  rewardRules        RewardRule[]
  rewardClaims       RewardClaim[]
  rewardGiftItems    RewardGiftItem[]
  rewardGiftsGiven   RewardGift[]
  serviceRequests    ServiceRequest[]  @relation("ServiceRequestHandledBy")
  vehicleRequests    VehicleRequest[]  @relation("VehicleRequestHandledBy")
  problemsResolved   WashProblem[]     @relation("WashProblemResolvedBy")

  @@index([shopId])
  @@index([phone])
  @@map("users")
}

model VehicleType {
  id         String  @id @default(uuid())
  shopId     String  @default("") @map("shop_id")
  name       String
  /// "car" | "bike" — drives which services appear on New Wash / Settings.
  category   String  @default("car")
  sortOrder  Int     @default(0) @map("sort_order")
  /// false = the owner deselected it. Kept (with its prices) because customers' vehicles use it.
  active     Boolean @default(true)
  /// The business body type it stands for (prices come from that body type's class and size).
  /// A plain id, not a relation: body types are business-level, outside the shop scope.
  bodyTypeId String? @map("body_type_id")
  /// Hidden because head office switched its body type off; switching it back on shows it again.
  hqHidden   Boolean @default(false) @map("hq_hidden")

  servicePrices   ServicePrice[]
  commissionRates CommissionRate[]
  vehicles        Vehicle[]
  vehicleRequests VehicleRequest[]
  priceOverrides  BranchPriceOverride[]
  memberVehicles  MemberVehicle[]

  @@index([shopId])
  @@map("vehicle_types")
}

model Service {
  id               String  @id @default(uuid())
  shopId           String  @default("") @map("shop_id")
  name             String
  description      String?
  active           Boolean @default(true)
  /// "car" | "bike" | "both" — which vehicle categories this service is offered for.
  appliesTo        String  @default("car") @map("applies_to")
  sortOrder        Int     @default(0) @map("sort_order")
  /// Generated from this business catalog service; null = made by hand at the branch.
  catalogServiceId String? @map("catalog_service_id")
  /// "hub" | "doorstep" | "both" — how it can be delivered.
  modes            String  @default("both")
  /// The branch stopped offering this catalog service (when the pricing policy allows it).
  branchHidden     Boolean @default(false) @map("branch_hidden")
  /// Copied from the catalog service: where the team does it, time, kind, badge, app, checklist.
  teamAt           String  @default("both") @map("team_at")
  durationMin      Int?    @map("duration_min")
  kind             String  @default("wash")
  popular          Boolean @default(false)
  showInApp        Boolean @default(true) @map("show_in_app")
  checklist        String?

  prices          ServicePrice[]
  commissionRates CommissionRate[]
  jobServices     JobService[]
  comboItems      ServiceComboItem[]    @relation("ComboItems")
  inCombos        ServiceComboItem[]    @relation("InCombos")
  rewardRule      RewardRule?
  rewardClaims    RewardClaim[]
  priceOverrides  BranchPriceOverride[]

  @@index([shopId])
  @@map("services")
}

/// A combo is a service with its own price per vehicle; these rows say which services it bundles.
model ServiceComboItem {
  shopId    String @default("") @map("shop_id")
  comboId   String @map("combo_id")
  serviceId String @map("service_id")

  combo   Service @relation("ComboItems", fields: [comboId], references: [id])
  service Service @relation("InCombos", fields: [serviceId], references: [id])

  @@id([comboId, serviceId])
  @@map("service_combo_items")
}

/// Staff commission (paise) for getting a customer to take a service, per vehicle size — only
/// on the services the owner picks. Copied onto job lines at creation.
model CommissionRate {
  shopId        String @default("") @map("shop_id")
  serviceId     String @map("service_id")
  vehicleTypeId String @map("vehicle_type_id")
  amount        Int

  service     Service     @relation(fields: [serviceId], references: [id])
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@id([serviceId, vehicleTypeId])
  @@map("commission_rates")
}

model ServicePrice {
  id            String @id @default(uuid())
  shopId        String @default("") @map("shop_id")
  serviceId     String @map("service_id")
  vehicleTypeId String @map("vehicle_type_id")
  price         Int // paise
  /// "hub" | "doorstep" — the same service can cost more at the doorstep.
  mode          String @default("hub")
  /// "manual" (typed at the branch) | "template" (from the catalog) | "override" (branch price).
  source        String @default("manual")
  /// The catalog price, for template and override rows.
  listPrice     Int?   @map("list_price")

  service     Service     @relation(fields: [serviceId], references: [id])
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@unique([serviceId, vehicleTypeId, mode])
  @@index([serviceId])
  @@index([shopId, vehicleTypeId])
  @@map("service_prices")
}

/// A branch's own price for a catalog service, within the business pricing policy. Kept even
/// when the policy stops applying it, so switching the policy back restores it.
model BranchPriceOverride {
  shopId          String   @default("") @map("shop_id")
  serviceId       String   @map("service_id")
  vehicleTypeId   String   @map("vehicle_type_id")
  mode            String // "hub" | "doorstep"
  price           Int
  updatedByUserId String   @map("updated_by_user_id")
  updatedAt       DateTime @default(now()) @map("updated_at")

  service     Service     @relation(fields: [serviceId], references: [id])
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@id([serviceId, vehicleTypeId, mode])
  @@index([shopId])
  @@map("branch_price_overrides")
}

/// How a branch delivers: its hub, and each doorstep team with its base and reach.
model ServicePoint {
  id        String   @id @default(uuid())
  shopId    String   @default("") @map("shop_id")
  kind      String // "hub" | "doorstep"
  name      String
  latitude  Float?
  longitude Float?
  radiusKm  Float?   @map("radius_km")
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  classes ServicePointClass[]

  @@unique([shopId, id])
  @@index([shopId, sortOrder])
  @@map("service_points")
}

/// The vehicle classes a service point washes. classId is a business-level vehicle class id.
model ServicePointClass {
  shopId  String @default("") @map("shop_id")
  pointId String @map("point_id")
  classId String @map("class_id")

  point ServicePoint @relation(fields: [pointId], references: [id])

  @@id([pointId, classId])
  @@map("service_point_classes")
}

model Customer {
  id               String   @id @default(uuid())
  shopId           String   @default("") @map("shop_id")
  name             String?
  phone            String
  source           String? // google | friend | board | instagram | other | app (Mana Wash request)
  marketingConsent Boolean  @default(false) @map("marketing_consent")
  createdAt        DateTime @default(now()) @map("created_at")
  /// Where they live, from their last doorstep wash: the next visit is measured from it.
  homeLatitude     Float?   @map("home_latitude")
  homeLongitude    Float?   @map("home_longitude")

  vehicles        Vehicle[]
  jobs            Job[]
  coupons         Coupon[]
  rewardGifts     RewardGift[]
  requests        ServiceRequest[]
  vehicleRequests VehicleRequest[]
  washRatings     WashRating[]
  problems        WashProblem[]
  referredBy      Referral?         @relation("ReferralReferred")
  referrals       Referral[]        @relation("ReferralReferrer")
  placeMembers    PlaceMember[]
  placeOrders     PlaceOrder[]
  payments        CustomerPayment[]

  @@unique([shopId, phone])
  @@map("customers")
}

model Vehicle {
  id                 String    @id @default(uuid())
  shopId             String    @default("") @map("shop_id")
  customerId         String    @map("customer_id")
  registrationNumber String    @map("registration_number")
  make               String?
  model              String?
  vehicleTypeId      String    @map("vehicle_type_id")
  /// Sync cursor for the phones' offline customer directory — see apps/api/schema.sql.
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  /// The customer removed it from their list in the Mana Wash app. Only hides it there.
  appHiddenAt        DateTime? @map("app_hidden_at")

  customer       Customer         @relation(fields: [customerId], references: [id])
  vehicleType    VehicleType      @relation(fields: [vehicleTypeId], references: [id])
  requests       VehicleRequest[]
  jobs           Job[]
  coupons        Coupon[]
  reminder       VehicleReminder?
  rewardClaims   RewardClaim[]
  rewardGifts    RewardGift[]
  memberVehicles MemberVehicle[]

  @@unique([shopId, registrationNumber])
  @@index([shopId, updatedAt, id])
  @@index([customerId])
  @@map("vehicles")
}

model Job {
  id              String    @id @default(uuid())
  shopId          String    @default("") @map("shop_id")
  customerId      String    @map("customer_id")
  vehicleId       String    @map("vehicle_id")
  createdByUserId String    @map("created_by_user_id")
  status          String    @default("waiting") // waiting | washing | ready | paid | void
  subtotal        Int
  discount        Int       @default(0)
  discountReason  String?   @map("discount_reason")
  total           Int
  paymentMethod   String?   @map("payment_method") // cash | upi | other
  paymentStatus   String    @default("pending") @map("payment_status")
  paidByUserId    String?   @map("paid_by_user_id")
  voidedByUserId  String?   @map("voided_by_user_id")
  voidReason      String?   @map("void_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  /// "hub" | "doorstep" — priced with that way's prices.
  deliveryMode    String    @default("hub") @map("delivery_mode")
  /// The hub or doorstep team that did it, when known.
  servicePointId  String?   @map("service_point_id")
  /// The service a community plan paid for on this wash: that line earns no loyalty stamp.
  planServiceId   String?   @map("plan_service_id")
  /// A doorstep wash: how far the home is from the branch, in km (the visit charge used it).
  visitKm         Float?    @map("visit_km")
  /// Where the home was (the visit charge was measured from the branch to here).
  visitLatitude   Float?    @map("visit_latitude")
  visitLongitude  Float?    @map("visit_longitude")
  /// A bill a wash plan was sold on: money in, not a wash.
  planSaleId      String?   @map("plan_sale_id")

  customer    Customer      @relation(fields: [customerId], references: [id])
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id])
  createdBy   User          @relation("JobCreatedBy", fields: [createdByUserId], references: [id])
  paidBy      User?         @relation("JobPaidBy", fields: [paidByUserId], references: [id])
  voidedBy    User?         @relation("JobVoidedBy", fields: [voidedByUserId], references: [id])
  jobServices JobService[]
  events      JobEvent[]
  washers     JobWasher[]
  sellers     JobSeller[]
  photos      JobPhoto[]
  rewardGifts RewardGift[]
  rating      WashRating?
  problems    WashProblem[]

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@index([shopId, completedAt])
  @@index([customerId, createdAt])
  @@index([vehicleId, createdAt])
  @@map("jobs")
}

model JobWasher {
  shopId           String   @default("") @map("shop_id")
  jobId            String   @map("job_id")
  userId           String   @map("user_id")
  assignedByUserId String   @map("assigned_by_user_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")

  job        Job  @relation(fields: [jobId], references: [id])
  user       User @relation("JobWasher", fields: [userId], references: [id])
  assignedBy User @relation("JobWasherAssignedBy", fields: [assignedByUserId], references: [id])

  @@id([jobId, userId])
  @@index([userId])
  @@map("job_washers")
}

/// Who got the customer to take a job's commission services; the commission is split between them.
model JobSeller {
  shopId           String   @default("") @map("shop_id")
  jobId            String   @map("job_id")
  userId           String   @map("user_id")
  assignedByUserId String   @map("assigned_by_user_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")

  job        Job  @relation(fields: [jobId], references: [id])
  user       User @relation("JobSeller", fields: [userId], references: [id])
  assignedBy User @relation("JobSellerAssignedBy", fields: [assignedByUserId], references: [id])

  @@id([jobId, userId])
  @@index([userId])
  @@map("job_sellers")
}

/// Before/after photo; the image itself is in R2 under `r2Key`.
model JobPhoto {
  id              String    @id
  shopId          String    @default("") @map("shop_id")
  jobId           String    @map("job_id")
  kind            String // before | after
  r2Key           String    @map("r2_key")
  contentType     String    @map("content_type")
  sizeBytes       Int       @map("size_bytes")
  takenByUserId   String    @map("taken_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id")

  job       Job   @relation(fields: [jobId], references: [id])
  takenBy   User  @relation("JobPhotoTakenBy", fields: [takenByUserId], references: [id])
  deletedBy User? @relation("JobPhotoDeletedBy", fields: [deletedByUserId], references: [id])

  @@index([jobId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("job_photos")
}

/// One row per person per IST day; `date` is `YYYY-MM-DD`.
model Attendance {
  shopId         String   @default("") @map("shop_id")
  userId         String   @map("user_id")
  date           String
  status         String // present | half | absent
  markedByUserId String   @map("marked_by_user_id")
  markedAt       DateTime @default(now()) @map("marked_at")

  user     User @relation("AttendanceUser", fields: [userId], references: [id])
  markedBy User @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id])

  @@id([userId, date])
  @@index([shopId, date])
  @@map("attendance")
}

/// The cash drawer for one IST day; `date` is `YYYY-MM-DD`. See apps/api/schema.sql.
model CashDay {
  shopId           String    @default("") @map("shop_id")
  date             String
  openingFloat     Int       @map("opening_float")
  floatSetByUserId String    @map("float_set_by_user_id")
  floatSetAt       DateTime  @default(now()) @map("float_set_at")
  expected         Int?
  counted          Int?
  note             String?
  closedByUserId   String?   @map("closed_by_user_id")
  closedAt         DateTime? @map("closed_at")
  reopenedByUserId String?   @map("reopened_by_user_id")
  reopenedAt       DateTime? @map("reopened_at")
  reopenReason     String?   @map("reopen_reason")
  /// Doorstep cash team members still held when the day closed.
  heldAtClose      Int?      @map("held_at_close")

  floatSetBy User  @relation("CashDayFloatSetBy", fields: [floatSetByUserId], references: [id])
  closedBy   User? @relation("CashDayClosedBy", fields: [closedByUserId], references: [id])
  reopenedBy User? @relation("CashDayReopenedBy", fields: [reopenedByUserId], references: [id])

  @@id([shopId, date])
  @@map("cash_days")
}

/// A close of a cash day that was later reopened — kept so a reopen never erases the count.
model CashDayClose {
  id               String    @id
  shopId           String    @default("") @map("shop_id")
  date             String
  openingFloat     Int       @map("opening_float")
  expected         Int?
  counted          Int?
  note             String?
  closedByUserId   String?   @map("closed_by_user_id")
  closedAt         DateTime  @map("closed_at")
  reopenedByUserId String?   @map("reopened_by_user_id")
  reopenedAt       DateTime? @map("reopened_at")
  reopenReason     String?   @map("reopen_reason")
  heldAtClose      Int?      @map("held_at_close")

  @@index([shopId, date])
  @@map("cash_day_closes")
}

/// Doorstep cash handed in by the team member who collected it. Append-only; voided, never edited.
model CashHandover {
  id               String    @id
  shopId           String    @default("") @map("shop_id")
  /// The IST day it was handed in: its drawer gets `received`.
  date             String
  collectorUserId  String    @map("collector_user_id")
  /// What this handover settles of what they held (all of it, or the part handed in when the rest comes later).
  due              Int
  received         Int
  note             String?
  receivedByUserId String    @map("received_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  voidedByUserId   String?   @map("voided_by_user_id")
  voidedAt         DateTime? @map("voided_at")
  voidReason       String?   @map("void_reason")

  @@index([shopId, date])
  @@index([shopId, collectorUserId])
  @@map("cash_handovers")
}

model Referral {
  id                 String    @id @default(uuid())
  shopId             String    @default("") @map("shop_id")
  referredCustomerId String    @unique @map("referred_customer_id")
  referrerCustomerId String    @map("referrer_customer_id")
  jobId              String    @unique @map("job_id")
  percent            Int
  status             String    @default("pending") // pending | rewarded | counted | cancelled
  rewardCouponId     String?   @map("reward_coupon_id")
  createdByUserId    String    @map("created_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  settledAt          DateTime? @map("settled_at")

  referred     Customer @relation("ReferralReferred", fields: [referredCustomerId], references: [id])
  referrer     Customer @relation("ReferralReferrer", fields: [referrerCustomerId], references: [id])
  rewardCoupon Coupon?  @relation(fields: [rewardCouponId], references: [id])
  createdBy    User     @relation(fields: [createdByUserId], references: [id])

  @@index([referrerCustomerId])
  @@index([shopId, status])
  @@map("referrals")
}

model AppSetting {
  shopId          String   @default("") @map("shop_id")
  key             String
  value           String
  updatedByUserId String?  @map("updated_by_user_id")
  updatedAt       DateTime @default(now()) @map("updated_at")

  updatedBy User? @relation("AppSettingUpdatedBy", fields: [updatedByUserId], references: [id])

  @@id([shopId, key])
  @@map("app_settings")
}

model LoginCode {
  id        String    @id @default(uuid())
  shopId    String    @default("") @map("shop_id")
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("login_codes")
}

/// WhatsApp codes for numbers that aren't a team sign-in: moving to a new number, and the Mana Wash
/// customer app. Platform-level.
model SignupCode {
  id        String    @id @default(uuid())
  phone     String
  purpose   String // phone | customer
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  ip        String?
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@map("signup_codes")
}

/// A named place a branch serves ("Kovur") — the backup when a customer doesn't share a location.
/// One live area per name — a partial unique index in schema.sql.
model ServiceArea {
  id        String   @id @default(uuid())
  shopId    String   @default("") @map("shop_id")
  name      String
  nameKey   String   @map("name_key")
  pincode   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  requests ServiceRequest[]

  @@unique([shopId, id])
  @@index([shopId])
  @@map("service_areas")
}

/// A phone number signed in to the Mana Wash app. Platform-level: the branches it belongs to
/// are the listed shops with a customer on this number, worked out on each request.
model CustomerAccount {
  id             String    @id @default(uuid())
  phone          String    @unique
  /// In every customer token; bumping it signs the app out on every phone.
  sessionVersion Int       @default(0) @map("session_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime? @map("last_seen_at")

  @@map("customer_accounts")
}

/// "Request service" from the app. One open request per phone — a partial unique index in schema.sql.
model ServiceRequest {
  id              String    @id @default(uuid())
  shopId          String    @default("") @map("shop_id")
  phone           String
  name            String?
  latitude        Float?
  longitude       Float?
  areaId          String?   @map("area_id")
  /// Landmark or address line, as typed (optional).
  address         String?
  placeKind       String?   @map("place_kind") // apartment | house | small_building | office | other
  placeName       String?   @map("place_name")
  homeText        String?   @map("home_text")
  cars            Int       @default(0)
  bikes           Int       @default(0)
  preferredTime   String?   @map("preferred_time") // early_morning | morning | evening | any
  notes           String?
  status          String    @default("pending") // pending | out_of_area | approved | rejected | cancelled
  handledByUserId String?   @map("handled_by_user_id")
  handledAt       DateTime? @map("handled_at")
  reason          String?
  customerId      String?   @map("customer_id")
  /// A place started near this request: the person can join it in one tap.
  invitedPlaceId  String?   @map("invited_place_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  area      ServiceArea? @relation(fields: [areaId], references: [id])
  handledBy User?        @relation("ServiceRequestHandledBy", fields: [handledByUserId], references: [id])
  customer  Customer?    @relation(fields: [customerId], references: [id])

  @@index([shopId, status, createdAt])
  @@index([phone, createdAt])
  @@map("service_requests")
}

/// "Add my vehicle" from the app. One pending request per plate per branch — a partial unique
/// index in schema.sql.
model VehicleRequest {
  id                 String    @id @default(uuid())
  shopId             String    @default("") @map("shop_id")
  customerId         String    @map("customer_id")
  registrationNumber String    @map("registration_number")
  vehicleTypeId      String    @map("vehicle_type_id")
  make               String?
  model              String?
  status             String    @default("pending") // pending | approved | rejected | cancelled
  vehicleId          String?   @map("vehicle_id")
  handledByUserId    String?   @map("handled_by_user_id")
  handledAt          DateTime? @map("handled_at")
  reason             String?
  createdAt          DateTime  @default(now()) @map("created_at")

  customer    Customer    @relation(fields: [customerId], references: [id])
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id])
  handledBy   User?       @relation("VehicleRequestHandledBy", fields: [handledByUserId], references: [id])

  @@index([shopId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("vehicle_requests")
}

/// A customer's rating of one of their paid washes.
model WashRating {
  jobId      String   @id @map("job_id")
  shopId     String   @default("") @map("shop_id")
  customerId String   @map("customer_id")
  stars      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  job      Job      @relation(fields: [jobId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([shopId, updatedAt])
  @@map("wash_ratings")
}

/// A problem a customer reported from the app, about one wash or the branch in general.
model WashProblem {
  id               String    @id @default(uuid())
  shopId           String    @default("") @map("shop_id")
  customerId       String    @map("customer_id")
  jobId            String?   @map("job_id")
  kind             String // not_clean | damage | missed_service | billing | staff | other
  details          String
  status           String    @default("open") // open | resolved
  resolution       String?
  resolvedByUserId String?   @map("resolved_by_user_id")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  customer   Customer @relation(fields: [customerId], references: [id])
  job        Job?     @relation(fields: [jobId], references: [id])
  resolvedBy User?    @relation("WashProblemResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([shopId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("wash_problems")
}

/// `shopId` is null for platform errors (e.g. a failed nightly job, a request before sign-in).
model AppError {
  id         String   @id @default(uuid())
  shopId     String?  @map("shop_id")
  source     String // app | api
  userId     String?  @map("user_id")
  message    String
  stack      String?
  context    String?
  appVersion String?  @map("app_version")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([shopId, createdAt])
  @@index([createdAt])
  @@map("app_errors")
}

/// Append-only audit trail — rows are only ever inserted, never updated or deleted.
model JobEvent {
  id        String   @id @default(uuid())
  shopId    String   @default("") @map("shop_id")
  jobId     String   @map("job_id")
  userId    String   @map("user_id")
  action    String // created | status_changed | paid | voided | payment_method_changed
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([jobId])
  @@index([shopId, createdAt])
  @@map("job_events")
}

model JobService {
  shopId           String @default("") @map("shop_id")
  jobId            String @map("job_id")
  serviceId        String @map("service_id")
  priceAtTime      Int    @map("price_at_time") // copied at creation time — never re-joins to the live price
  commissionAtTime Int    @default(0) @map("commission_at_time") // per unit, copied the same way
  quantity         Int    @default(1)

  job     Job     @relation(fields: [jobId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([jobId, serviceId])
  @@map("job_services")
}

/// Comeback coupon — see apps/api/schema.sql for the redemption rules and the
/// one-active-per-vehicle partial unique index (not expressible in Prisma).
model Coupon {
  id               String    @id @default(uuid())
  shopId           String    @default("") @map("shop_id")
  code             String
  kind             String    @default("comeback") // comeback | referral
  vehicleId        String    @map("vehicle_id")
  customerId       String    @map("customer_id")
  percent          Int
  status           String    @default("active") // active | redeemed | cancelled
  expiresAt        DateTime  @map("expires_at")
  issuedByUserId   String    @map("issued_by_user_id")
  redeemedJobId    String?   @unique @map("redeemed_job_id")
  redeemedByUserId String?   @map("redeemed_by_user_id")
  redeemedAt       DateTime? @map("redeemed_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason") // replaced | owner_changed | referral_voided
  notifiedAt       DateTime? @map("notified_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])
  issuedBy   User       @relation("CouponIssuedBy", fields: [issuedByUserId], references: [id])
  redeemedBy User?      @relation("CouponRedeemedBy", fields: [redeemedByUserId], references: [id])
  referrals  Referral[]

  @@unique([shopId, code])
  @@index([customerId])
  @@index([shopId, status, expiresAt])
  @@index([shopId, redeemedAt])
  @@map("coupons")
}

model VehicleReminder {
  vehicleId         String    @id @map("vehicle_id")
  shopId            String    @default("") @map("shop_id")
  lastVisitAt       DateTime  @map("last_visit_at")
  remindedAt        DateTime? @map("reminded_at")
  remindedByUserId  String?   @map("reminded_by_user_id")
  snoozedUntil      DateTime? @map("snoozed_until")
  dismissedAt       DateTime? @map("dismissed_at")
  dismissedByUserId String?   @map("dismissed_by_user_id")

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id])
  remindedBy  User?   @relation("VehicleReminderRemindedBy", fields: [remindedByUserId], references: [id])
  dismissedBy User?   @relation("VehicleReminderDismissedBy", fields: [dismissedByUserId], references: [id])

  @@index([shopId])
  @@map("vehicle_reminders")
}

model Expense {
  id              String    @id @default(uuid())
  shopId          String    @default("") @map("shop_id")
  category        String
  amount          Int // paise
  description     String? // "used for" / free note
  itemName        String?   @map("item_name")
  quantity        Float?
  unit            String? // ml | l | g | kg | pcs | kwh | days | hours | tankers
  billPhotoKey    String?   @map("bill_photo_key")
  itemPhotoKey    String?   @map("item_photo_key")
  paymentMethod   String    @default("cash") @map("payment_method") // cash | upi | other
  /// Cash only: "drawer" (the shop's box) or "held" (doorstep cash the person who entered it held).
  cashSource      String    @default("drawer") @map("cash_source")
  date            DateTime
  createdByUserId String    @map("created_by_user_id")
  voidedByUserId  String?   @map("voided_by_user_id")
  voidReason      String?   @map("void_reason")
  voidedAt        DateTime? @map("voided_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  createdBy  User        @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  voidedBy   User?       @relation("ExpenseVoidedBy", fields: [voidedByUserId], references: [id])
  stockMoves StockMove[]
  edits      ExpenseEdit[]

  @@index([shopId, date])
  @@map("expenses")
}

/// An edit of an expense, append-only: who, why, and each field's old and new value (JSON).
model ExpenseEdit {
  id              String   @id @default(uuid())
  shopId          String   @default("") @map("shop_id")
  expenseId       String   @map("expense_id")
  editedByUserId  String   @map("edited_by_user_id")
  reason          String
  changes         String // JSON: [{ field, from, to }]
  createdAt       DateTime @default(now()) @map("created_at")

  expense  Expense @relation(fields: [expenseId], references: [id])
  editedBy User    @relation("ExpenseEditedBy", fields: [editedByUserId], references: [id])

  @@index([shopId, createdAt])
  @@index([shopId, expenseId])
  @@map("expense_edits")
}

/// A consumable the shop keeps. `balance` (base unit) always equals the sum of its moves; one live
/// item per name — a partial unique index in schema.sql, which Prisma can't express.
model StockItem {
  id              String   @id @default(uuid())
  shopId          String   @default("") @map("shop_id")
  name            String
  nameKey         String   @map("name_key")
  unit            String // l | kg | pcs
  balance         Float    @default(0)
  lowAt           Float?   @map("low_at")
  active          Boolean  @default(true)
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  createdBy   User            @relation("StockItemCreatedBy", fields: [createdByUserId], references: [id])
  moves       StockMove[]
  giftItem    RewardGiftItem?
  rewardGifts RewardGift[]

  @@map("stock_items")
}

/// Append-only: every change to a stock balance. `quantity` is signed, in the item's unit.
model StockMove {
  id              String   @id @default(uuid())
  shopId          String   @default("") @map("shop_id")
  itemId          String   @map("item_id")
  kind            String // in | use | count | void | gift
  quantity        Float
  balanceAfter    Float    @map("balance_after")
  note            String?
  expenseId       String?  @map("expense_id")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  item      StockItem @relation(fields: [itemId], references: [id])
  createdBy User      @relation("StockMoveCreatedBy", fields: [createdByUserId], references: [id])
  expense   Expense?  @relation(fields: [expenseId], references: [id])

  @@index([itemId, createdAt])
  @@index([shopId, kind, createdAt])
  @@index([expenseId])
  @@map("stock_moves")
}

/// Stamp card for one service: every `every` paid visits earn one free wash. Cards themselves
/// aren't stored — see apps/api/schema.sql.
model RewardRule {
  serviceId       String   @id @map("service_id")
  shopId          String   @default("") @map("shop_id")
  every           Int
  active          Boolean  @default(true)
  updatedByUserId String   @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  service   Service @relation(fields: [serviceId], references: [id])
  updatedBy User    @relation(fields: [updatedByUserId], references: [id])

  @@index([shopId])
  @@map("reward_rules")
}

/// A free wash used from a car's card. `jobId` is written before the job, so not a relation.
model RewardClaim {
  id              String   @id @default(uuid())
  shopId          String   @default("") @map("shop_id")
  vehicleId       String   @map("vehicle_id")
  serviceId       String   @map("service_id")
  seq             Int
  jobId           String   @map("job_id")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])
  createdBy User    @relation(fields: [createdByUserId], references: [id])

  @@unique([vehicleId, serviceId, seq])
  @@unique([jobId, serviceId])
  @@index([jobId])
  @@index([shopId, createdAt])
  @@map("reward_claims")
}

/// One item of the welcome gift every new car gets, in the item's stock unit.
model RewardGiftItem {
  stockItemId     String   @id @map("stock_item_id")
  shopId          String   @default("") @map("shop_id")
  quantity        Float
  sortOrder       Int      @default(0) @map("sort_order")
  updatedByUserId String   @map("updated_by_user_id")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  item      StockItem @relation(fields: [stockItemId], references: [id])
  updatedBy User      @relation(fields: [updatedByUserId], references: [id])

  @@index([shopId])
  @@map("reward_gift_items")
}

/// A welcome-gift item for one car: owed until handed over, given, or cancelled with its wash.
/// One live gift per car and item — a partial unique index in schema.sql.
model RewardGift {
  id            String    @id
  shopId        String    @default("") @map("shop_id")
  jobId         String    @map("job_id")
  vehicleId     String    @map("vehicle_id")
  customerId    String    @map("customer_id")
  stockItemId   String    @map("stock_item_id")
  quantity      Float
  status        String    @default("owed") // owed | given | cancelled
  givenAt       DateTime? @map("given_at")
  givenByUserId String?   @map("given_by_user_id")
  cancelledAt   DateTime? @map("cancelled_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  job      Job       @relation(fields: [jobId], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  item     StockItem @relation(fields: [stockItemId], references: [id])
  givenBy  User?     @relation(fields: [givenByUserId], references: [id])

  @@index([jobId])
  @@index([shopId, status])
  @@index([shopId, givenAt])
  @@index([stockItemId, status])
  @@map("reward_gifts")
}

/// Fixed-window counters for brute-force protection, keyed like "pin:ip:1.2.3.4". Platform-level.
/// Written with one atomic upsert straight through D1 (apps/api/src/lib/rateLimit.ts).
model RateLimit {
  key         String @id
  windowStart Int    @map("window_start")
  count       Int

  @@index([windowStart])
  @@map("rate_limits")
}

// ─── Service network (business-level, not shop-scoped) ───────────────────────
// A business owns one catalog; each branch's services and service_prices are generated from it
// (src/repositories/catalogRepo.ts). These models carry businessId instead of shopId and are in
// PLATFORM_MODELS (src/client.ts): read and write them only through catalogRepo, which always
// filters by business.

model Business {
  id             String   @id
  name           String
  /// Bumped on every catalog change; branches whose menuVersion is behind get rebuilt.
  catalogVersion Int      @default(1) @map("catalog_version")
  createdAt      DateTime @default(now()) @map("created_at")

  admins     BusinessAdmin[]
  settings   BusinessSetting[]
  classes    VehicleClass[]
  sizes      VehicleSize[]
  bodyTypes  BodyType[]
  services   CatalogService[]
  priceBooks PriceBook[]
  zones      PriceZone[]

  @@map("businesses")
}

/// Who runs the business catalog, by phone (an owner has one user row per branch, same number).
model BusinessAdmin {
  businessId String   @map("business_id")
  phone      String
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@id([businessId, phone])
  @@index([phone])
  @@map("business_admins")
}

model BusinessSetting {
  businessId     String   @map("business_id")
  key            String
  value          String
  updatedByPhone String?  @map("updated_by_phone")
  updatedAt      DateTime @default(now()) @map("updated_at")

  business Business @relation(fields: [businessId], references: [id])

  @@id([businessId, key])
  @@map("business_settings")
}

/// Two-wheeler, Car, Farm & machines… Keys are fixed (packages/domain vehicleCatalog.ts).
model VehicleClass {
  id         String @id
  businessId String @map("business_id")
  key        String
  name       String
  sortOrder  Int    @default(0) @map("sort_order")

  business  Business              @relation(fields: [businessId], references: [id])
  sizes     VehicleSize[]
  bodyTypes BodyType[]
  services  CatalogServiceClass[]

  @@unique([businessId, key])
  @@unique([businessId, id])
  @@map("vehicle_classes")
}

model VehicleSize {
  id         String @id
  businessId String @map("business_id")
  classId    String @map("class_id")
  key        String // S | M | L | XL
  name       String
  sortOrder  Int    @default(0) @map("sort_order")

  business  Business         @relation(fields: [businessId], references: [id])
  class     VehicleClass     @relation(fields: [classId], references: [id])
  bodyTypes BodyType[]
  prices    PriceBookEntry[]

  @@unique([classId, key])
  @@unique([businessId, id])
  @@unique([classId, id])
  @@map("vehicle_sizes")
}

/// Sedan, Tractor…: what a branch vehicle type stands for; its size can be moved.
model BodyType {
  id         String  @id
  businessId String  @map("business_id")
  key        String
  name       String
  classId    String  @map("class_id")
  sizeId     String  @map("size_id")
  sortOrder  Int     @default(0) @map("sort_order")
  active     Boolean @default(true)

  business Business     @relation(fields: [businessId], references: [id])
  class    VehicleClass @relation(fields: [classId], references: [id])
  size     VehicleSize  @relation(fields: [sizeId], references: [id])

  @@unique([businessId, key])
  @@unique([businessId, id])
  @@map("body_types")
}

/// A head-office service switched on for one branch: the branch's menu is built from these.
/// Head office's changes to the built-in list of companies and models (bodyKey null = removed).
model VehicleModel {
  businessId     String   @map("business_id")
  modelKey       String   @map("model_key")
  make           String
  model          String
  category       String
  bodyKey        String?  @map("body_key")
  updatedByPhone String?  @map("updated_by_phone")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@id([businessId, modelKey])
  @@map("vehicle_models")
}

/// The kinds of vehicle a branch washes (a body type: Hatchback, Tractor…). No rows = every kind.
model BranchBodyType {
  shopId     String   @default("") @map("shop_id")
  bodyTypeId String   @map("body_type_id")
  addedAt    DateTime @default(now()) @map("added_at")

  @@id([shopId, bodyTypeId])
  @@index([bodyTypeId])
  @@map("branch_body_types")
}

model BranchMenuService {
  shopId           String   @default("") @map("shop_id")
  catalogServiceId String   @map("catalog_service_id")
  addedAt          DateTime @default(now()) @map("added_at")

  @@id([shopId, catalogServiceId])
  @@index([catalogServiceId])
  @@map("branch_menu_services")
}

model CatalogService {
  id          String   @id
  businessId  String   @map("business_id")
  name        String
  description String?
  /// "hub" | "doorstep" | "both" — shop, the community team, or both.
  modes       String   @default("both")
  /// "both" | "community" | "doorstep" — where the community team does it.
  teamAt      String   @default("both") @map("team_at")
  /// How long it takes, in minutes (up to 30 days).
  durationMin Int?     @map("duration_minutes")
  /// "wash" | "protection" | "addon"
  kind        String   @default("wash")
  popular     Boolean  @default(false)
  showInApp   Boolean  @default(true) @map("show_in_app")
  /// JSON list of short lines: what's included.
  checklist   String?
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  business   Business              @relation(fields: [businessId], references: [id])
  classes    CatalogServiceClass[]
  comboItems CatalogComboItem[]    @relation("CatalogComboItems")
  inCombos   CatalogComboItem[]    @relation("CatalogInCombos")
  prices     PriceBookEntry[]

  @@unique([businessId, id])
  @@index([businessId, sortOrder])
  @@map("catalog_services")
}

/// A size a catalog service is for (within one of its vehicle classes).
model CatalogServiceSize {
  businessId String @map("business_id")
  serviceId  String @map("service_id")
  sizeId     String @map("size_id")

  @@id([serviceId, sizeId])
  @@map("catalog_service_sizes")
}

model CatalogServiceClass {
  businessId String @map("business_id")
  serviceId  String @map("service_id")
  classId    String @map("class_id")

  service CatalogService @relation(fields: [serviceId], references: [id])
  class   VehicleClass   @relation(fields: [classId], references: [id])

  @@id([serviceId, classId])
  @@map("catalog_service_classes")
}

model CatalogComboItem {
  businessId String @map("business_id")
  comboId    String @map("combo_id")
  serviceId  String @map("service_id")

  combo   CatalogService @relation("CatalogComboItems", fields: [comboId], references: [id])
  service CatalogService @relation("CatalogInCombos", fields: [serviceId], references: [id])

  @@id([comboId, serviceId])
  @@map("catalog_combo_items")
}

/// A price table; one default per business (partial unique index in schema.sql).
model PriceBook {
  id         String   @id
  businessId String   @map("business_id")
  name       String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business         @relation(fields: [businessId], references: [id])
  entries  PriceBookEntry[]

  @@unique([businessId, id])
  @@map("price_books")
}

/// Base price (paise) of a catalog service for one vehicle size.
model PriceBookEntry {
  businessId  String   @map("business_id")
  priceBookId String   @map("price_book_id")
  serviceId   String   @map("service_id")
  sizeId      String   @map("size_id")
  price       Int
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  /// Its own community (doorstep) price; null = base price + the doorstep rule.
  doorstepPrice Int?   @map("doorstep_price")

  priceBook PriceBook      @relation(fields: [priceBookId], references: [id])
  service   CatalogService @relation(fields: [serviceId], references: [id])
  size      VehicleSize    @relation(fields: [sizeId], references: [id])

  @@id([priceBookId, serviceId, sizeId])
  @@map("price_book_entries")
}

/// Extra for a way of delivering (doorstep). classId null = every class.
model ModeAdjustment {
  id            String   @id
  businessId    String   @map("business_id")
  mode          String
  classId       String?  @map("class_id")
  percentBp     Int      @default(0) @map("percent_bp")
  fixedPaise    Int      @default(0) @map("fixed_paise")
  minExtraPaise Int      @default(0) @map("min_extra_paise")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("mode_adjustments")
}

model PriceZone {
  id         String   @id
  businessId String   @map("business_id")
  name       String
  percentBp  Int      @default(0) @map("percent_bp")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, id])
  @@map("price_zones")
}

// ─── Places and plans ───────────────────────────────────────────────────────

/// A building, gated colony or street a branch's team washes at on fixed days.
model Place {
  id              String   @id @default(uuid())
  shopId          String   @default("") @map("shop_id")
  /// On the QR poster and in invite links (7 unambiguous characters).
  code            String   @unique
  type            String // building | colony | street
  name            String?
  label           String
  latitude        Float
  longitude       Float
  photoKey        String?  @map("photo_key")
  /// Weekdays, Sunday = 0: "2" or "2,5".
  washDays        String   @map("wash_days")
  /// "HH:MM" IST.
  washTime        String   @map("wash_time")
  needsApproval   Boolean  @default(false) @map("needs_approval")
  /// Vehicles per wash day; null = no limit.
  capacity        Int?
  status          String   @default("active") // active | paused | closed
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  /// Setup: draft (being inspected) | review (sent to the owner) | live.
  stage            String    @default("live")
  /// JSON (packages/domain communities.ts).
  inspection       String?
  contactName      String?   @map("contact_name")
  contactPhone     String?   @map("contact_phone")
  notes            String?
  /// JSON: [{"days":[3,5,0],"time":"06:30"}], best first.
  proposedSlots    String?   @map("proposed_slots")
  /// User ids, comma separated.
  teamUserIds      String?   @map("team_user_ids")
  reviewNote       String?   @map("review_note")
  submittedAt      DateTime? @map("submitted_at")
  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")

  units   PlaceUnit[]
  members PlaceMember[]
  visits  PlaceVisit[]
  photos  PlacePhoto[]

  @@unique([shopId, id])
  @@index([shopId, status])
  @@map("places")
}

model PlacePhoto {
  id              String   @id @default(uuid())
  shopId          String   @default("") @map("shop_id")
  placeId         String   @map("place_id")
  photoKey        String   @map("photo_key")
  kind            String // gate | parking | water | building | other
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  place Place @relation(fields: [placeId], references: [id])

  @@unique([shopId, id])
  @@index([placeId, createdAt])
  @@map("place_photos")
}

model PlaceUnit {
  id         String    @id @default(uuid())
  shopId     String    @default("") @map("shop_id")
  placeId    String    @map("place_id")
  block      String?
  number     String
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  place   Place         @relation(fields: [placeId], references: [id])
  members PlaceMember[]

  @@unique([shopId, id])
  @@map("place_units")
}

/// A customer living at a place. One live (pending or active) membership per place — a partial
/// unique index in schema.sql.
model PlaceMember {
  id              String    @id @default(uuid())
  shopId          String    @default("") @map("shop_id")
  placeId         String    @map("place_id")
  customerId      String    @map("customer_id")
  unitId          String?   @map("unit_id")
  unitText        String?   @map("unit_text")
  status          String // pending | active | left | removed
  joinedVia       String    @map("joined_via") // qr | link | app | staff
  distanceM       Int?      @map("distance_m")
  /// far_away, needs_approval, unit_taken, not_found (comma list).
  checks          String?
  parkingNote     String?   @map("parking_note")
  addedByUserId   String?   @map("added_by_user_id")
  handledByUserId String?   @map("handled_by_user_id")
  handledAt       DateTime? @map("handled_at")
  endedAt         DateTime? @map("ended_at")
  endReason       String?   @map("end_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  place    Place           @relation(fields: [placeId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  unit     PlaceUnit?      @relation(fields: [unitId], references: [id])
  vehicles MemberVehicle[]
  orders   PlaceOrder[]

  @@unique([shopId, id])
  @@index([shopId, placeId, status])
  @@index([customerId, status])
  @@map("place_members")
}

model MemberVehicle {
  id            String   @id @default(uuid())
  shopId        String   @default("") @map("shop_id")
  memberId      String   @map("member_id")
  customerId    String   @map("customer_id")
  vehicleTypeId String   @map("vehicle_type_id")
  /// The branch's vehicle, once the plate is known.
  vehicleId     String?  @map("vehicle_id")
  status        String   @default("active") // active | removed
  createdAt     DateTime @default(now()) @map("created_at")

  member      PlaceMember  @relation(fields: [memberId], references: [id])
  vehicleType VehicleType  @relation(fields: [vehicleTypeId], references: [id])
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  orders      PlaceOrder[]
  visits      PlaceVisit[]

  @@unique([shopId, id])
  @@index([memberId, status])
  @@map("member_vehicles")
}

/// Monthly, quarterly, yearly… set up once for the business. Business-level (not shop-scoped).
model WashPlan {
  id               String   @id
  businessId       String   @map("business_id")
  name             String
  washes           Int
  months           Int
  catalogServiceId String   @map("catalog_service_id")
  discountBp       Int      @default(0) @map("discount_bp")
  allowParts       Boolean  @default(false) @map("allow_parts")
  popular          Boolean  @default(false)
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  /// Every Nth wash is this service instead (Shine: every 4th is Premium).
  upgradeServiceId String?  @map("upgrade_service_id")
  upgradeEvery     Int?     @map("upgrade_every")
  /// "community" | "shop" | "both": where it's sold.
  soldAt           String   @default("community") @map("sold_at")
  /// A community plan can also pay for a wash at the shop.
  shopUse          Boolean  @default(true) @map("shop_use")

  @@unique([businessId, id])
  @@index([businessId, sortOrder])
  @@map("wash_plans")
}

/// A wash plan sold at the counter, for one vehicle, at this branch.
model ShopPlanOrder {
  id               String    @id @default(uuid())
  shopId           String    @default("") @map("shop_id")
  planId           String    @map("plan_id")
  customerId       String    @map("customer_id")
  vehicleId        String    @map("vehicle_id")
  title            String
  catalogServiceId String    @map("catalog_service_id")
  upgradeServiceId String?   @map("upgrade_service_id")
  upgradeEvery     Int?      @map("upgrade_every")
  washesTotal      Int       @map("washes_total")
  washesUsed       Int       @default(0) @map("washes_used")
  price            Int
  paymentMethod    String    @map("payment_method")
  saleJobId        String    @map("sale_job_id")
  startsOn         String    @map("starts_on")
  endsOn           String    @map("ends_on")
  status           String    @default("active")
  soldByUserId     String    @map("sold_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  endedAt          DateTime? @map("ended_at")

  @@unique([shopId, id])
  @@index([shopId, vehicleId, status])
  @@map("shop_plan_orders")
}

/// One wash a shop plan paid for (one a day).
model ShopPlanUse {
  id        String   @id @default(uuid())
  shopId    String   @default("") @map("shop_id")
  orderId   String   @map("order_id")
  jobId     String   @map("job_id")
  day       String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([shopId, orderId, day])
  @@unique([shopId, jobId])
  @@map("shop_plan_uses")
}

/// A plan's fixed price for one vehicle size and way of washing. No row = priced from its wash.
model WashPlanPrice {
  businessId String   @map("business_id")
  planId     String   @map("plan_id")
  sizeId     String   @map("size_id")
  mode       String
  price      Int
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([planId, sizeId, mode])
  @@map("wash_plan_prices")
}

/// A plan or one-time wash for one member vehicle.
model PlaceOrder {
  id              String    @id @default(uuid())
  shopId          String    @default("") @map("shop_id")
  customerId      String    @map("customer_id")
  memberId        String    @map("member_id")
  memberVehicleId String    @map("member_vehicle_id")
  kind            String // plan | single
  planId          String?   @map("plan_id")
  title           String
  /// JSON: what was sold (items, prices, rules) at the time.
  snapshot        String
  washesTotal     Int       @map("washes_total")
  washesUsed      Int       @default(0) @map("washes_used")
  months          Int       @default(1)
  perWeek         Int       @default(1) @map("per_week")
  singlePrice     Int       @map("single_price")
  total           Int
  payMode         String    @default("full") @map("pay_mode") // full | parts
  status          String // waitlist | awaiting_payment | active | ended | cancelled
  firstWashOn     String?   @map("first_wash_on")
  renewalOf       String?   @map("renewal_of")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")
  cancelledBy     String?   @map("cancelled_by") // customer | staff | system
  refundDue       Int       @default(0) @map("refund_due")
  endedAt         DateTime? @map("ended_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  customer      Customer           @relation(fields: [customerId], references: [id])
  member        PlaceMember        @relation(fields: [memberId], references: [id])
  memberVehicle MemberVehicle      @relation(fields: [memberVehicleId], references: [id])
  installments  OrderInstallment[]
  pauses        OrderPause[]
  visits        PlaceVisit[]
  payments      CustomerPayment[]

  @@unique([shopId, id])
  @@index([memberId, status])
  @@index([memberVehicleId, status])
  @@index([customerId, createdAt])
  @@index([shopId, status, firstWashOn])
  @@map("place_orders")
}

model OrderInstallment {
  id        String    @id @default(uuid())
  shopId    String    @default("") @map("shop_id")
  orderId   String    @map("order_id")
  seq       Int
  amount    Int
  dueOn     String    @map("due_on")
  status    String    @default("due") // due | paid | cancelled
  paymentId String?   @map("payment_id")
  paidAt    DateTime? @map("paid_at")

  order    PlaceOrder        @relation(fields: [orderId], references: [id])
  payments CustomerPayment[]

  @@unique([orderId, seq])
  @@unique([shopId, id])
  @@index([shopId, status, dueOn])
  @@map("order_installments")
}

model OrderPause {
  id          String    @id @default(uuid())
  shopId      String    @default("") @map("shop_id")
  orderId     String    @map("order_id")
  fromOn      String    @map("from_on")
  toOn        String    @map("to_on")
  createdAt   DateTime  @default(now()) @map("created_at")
  cancelledAt DateTime? @map("cancelled_at")

  order PlaceOrder @relation(fields: [orderId], references: [id])

  @@unique([shopId, id])
  @@index([orderId])
  @@map("order_pauses")
}

model PlaceVisit {
  id              String   @id @default(uuid())
  shopId          String   @default("") @map("shop_id")
  placeId         String   @map("place_id")
  orderId         String   @map("order_id")
  memberVehicleId String   @map("member_vehicle_id")
  date            String
  outcome         String // done | skipped | not_found | missed
  byUserId        String?  @map("by_user_id")
  byCustomer      Boolean  @default(false) @map("by_customer")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  photoKey        String?  @map("photo_key")
  /// How far from the place the washer recorded it.
  distanceM       Int?     @map("distance_m")
  /// A plan wash used at the shop: the shop wash it paid for.
  jobId           String?  @map("job_id")

  place         Place         @relation(fields: [placeId], references: [id])
  order         PlaceOrder    @relation(fields: [orderId], references: [id])
  memberVehicle MemberVehicle @relation(fields: [memberVehicleId], references: [id])

  @@unique([orderId, date])
  @@unique([shopId, id])
  @@index([placeId, date])
  @@map("place_visits")
}

/// One attempt to pay one installment through Razorpay (or the local test checkout).
model CustomerPayment {
  id                String    @id @default(uuid())
  shopId            String    @default("") @map("shop_id")
  customerId        String    @map("customer_id")
  orderId           String    @map("order_id")
  installmentId     String    @map("installment_id")
  amount            Int
  status            String    @default("created") // created | paid | failed | expired
  provider          String // razorpay | test
  linkId            String?   @unique @map("link_id")
  linkUrl           String?   @map("link_url")
  providerPaymentId String?   @map("provider_payment_id")
  method            String?
  refunded          Int       @default(0)
  receiptNo         String?   @unique @map("receipt_no")
  gstRateBp         Int       @default(0) @map("gst_rate_bp")
  createdBy         String    @map("created_by") // customer | staff
  expiresAt         DateTime  @map("expires_at")
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  customer    Customer         @relation(fields: [customerId], references: [id])
  order       PlaceOrder       @relation(fields: [orderId], references: [id])
  installment OrderInstallment @relation(fields: [installmentId], references: [id])
  refunds     CustomerRefund[]

  @@unique([shopId, id])
  @@index([orderId, createdAt])
  @@map("customer_payments")
}

model CustomerRefund {
  id               String    @id @default(uuid())
  shopId           String    @default("") @map("shop_id")
  paymentId        String    @map("payment_id")
  orderId          String    @map("order_id")
  amount           Int
  status           String    @default("pending") // pending | processed | failed
  providerRefundId String?   @map("provider_refund_id")
  reason           String?
  createdAt        DateTime  @default(now()) @map("created_at")
  processedAt      DateTime? @map("processed_at")

  payment CustomerPayment @relation(fields: [paymentId], references: [id])

  @@unique([shopId, id])
  @@index([paymentId])
  @@map("customer_refunds")
}

model ReceiptSeries {
  shopId        String @map("shop_id")
  financialYear String @map("financial_year")
  lastNumber    Int    @default(0) @map("last_number")

  @@id([shopId, financialYear])
  @@map("receipt_series")
}

// ─── Towns and pincodes (opening branches) ─────────────────────────────────

/// India Post offices (data.gov.in): pincode → district, state, places. Loaded by a script.
model PostOffice {
  pincode   String
  name      String
  kind      String // HO | PO | BO
  district  String
  state     String
  latitude  Float?
  longitude Float?

  @@id([pincode, name, kind, district])
  @@index([pincode])
  @@map("post_offices")
}

/// A town a business has branches in, with its 3-letter code for good.
model BranchTown {
  id         String   @id
  businessId String   @map("business_id")
  code       String
  name       String
  nameKey    String   @map("name_key")
  district   String
  state      String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([businessId, code])
  @@unique([businessId, state, district, nameKey])
  @@map("branch_towns")
}
