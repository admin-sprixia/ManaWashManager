{
  "name": "@mana/customer",
  "version": "0.5.1",
  "private": true,
  "description": "MANA Car Wash — the app for car owners (sign in, my cars, wash history and photos, request service).",
  "scripts": {
    "android": "react-native run-android --port 8082 && npm run reverse",
    "reverse": "for d in $(adb devices | awk 'NR>1 && $2==\"device\" {print $1}'); do adb -s $d reverse tcp:8082 tcp:8082 && adb -s $d reverse tcp:8787 tcp:8787; done",
    "ios": "react-native run-ios --port 8082",
    "pods": "cd ios && bundle install && bundle exec pod install",
    "start": "react-native start --port 8082",
    "typecheck": "tsc --noEmit",
    "set-api-url": "node scripts/set-api-url.mjs",
    "build:release": "cd android && ./gradlew bundleRelease assembleRelease"
  },
  "dependencies": {
    "@mana/api": "*",
    "@mana/domain": "*",
    "@mana/ui": "*",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/geolocation": "^3.3.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "hono": "^4.4.0",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-keychain": "^8.2.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "^3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@babel/runtime": "^7.24.5",
    "@react-native/babel-preset": "0.74.83",
    "@react-native/metro-config": "0.74.83",
    "@react-native/typescript-config": "0.74.83",
    "@types/react": "^18.2.6",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
