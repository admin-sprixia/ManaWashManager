{
  "name": "@mana/api",
  "version": "2.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "predev": "npm run db:generate -w @mana/db",
    "dev": "wrangler dev",
    "predeploy": "npm run db:generate -w @mana/db",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:reset:local": "wrangler d1 execute mana_db --local --file=./schema.sql",
    "db:reset:remote": "wrangler d1 execute mana_db --remote --file=./schema.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.2.2",
    "@mana/db": "*",
    "@mana/domain": "*",
    "hono": "^4.4.0",
    "jose": "^5.2.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240502.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.57.0"
  }
}
