<resources>

    <!-- Android 12+ always shows a system splash. Give it the launch gradient's middle colour and no icon, so it
         flows straight into the app's own splash animation, which draws the logo. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>

</resources>
