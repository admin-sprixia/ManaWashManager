{
  "name": "@mana/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android && npm run reverse",
    "reverse": "for d in $(adb devices | awk 'NR>1 && $2==\"device\" {print $1}'); do adb -s $d reverse tcp:8081 tcp:8081 && adb -s $d reverse tcp:8787 tcp:8787; done",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@mana/api": "*",
    "@mana/domain": "*",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "hono": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-blob-util": "^0.25.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "^3.31.1",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@react-native/babel-preset": "0.74.83",
    "@react-native/eslint-config": "0.74.83",
    "@react-native/metro-config": "0.74.83",
    "@react-native/typescript-config": "0.74.83",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.6",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
