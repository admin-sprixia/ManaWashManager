node_modules/
dist/
.wrangler/
*.db
*.db-journal
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.*
!.dev.vars.example

# React Native / iOS — patterns use **/ so they match at any depth (e.g. apps/mobile/ios/...),
# not just a top-level ios/ folder.
**/ios/Pods/
**/ios/build/
**/ios/*.xcworkspace

# React Native / Android — Gradle's own build/cache output, never source.
**/android/build/
**/android/app/build/
**/android/.gradle/
**/android/.cxx/
**/android/app/.cxx/
**/android/local.properties
**/android/*.hprof
**/android/captures/
**/.idea/
*.iml
*.jsbundle

# misc
coverage/
.DS_Store
