{
  "name": "@mana/api",
  "version": "0.5.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "predev": "npm run db:generate -w @mana/db",
    "dev": "wrangler dev --test-scheduled",
    "predeploy": "npm run db:generate -w @mana/db",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:isolation": "node scripts/isolation-check.mjs",
    "test:expenses": "node scripts/expense-check.mjs",
    "test:team": "node scripts/team-check.mjs",
    "test:access": "node scripts/access-check.mjs",
    "test:races": "node scripts/race-check.mjs",
    "test:cash": "node scripts/cash-check.mjs",
    "test:stock": "node scripts/stock-check.mjs",
    "test:reports": "node scripts/reports-check.mjs",
    "test:services": "node scripts/services-check.mjs",
    "test:rewards": "node scripts/rewards-check.mjs",
    "test:customer-app": "node scripts/customer-app-check.mjs",
    "test:catalog": "node scripts/catalog-check.mjs",
    "test:places": "node scripts/places-check.mjs",
    "test:branch-towns": "node scripts/branch-towns-check.mjs",
    "test:branch-services": "node scripts/branch-services-check.mjs",
    "test:pricing": "node scripts/pricing-check.mjs",
    "test:shop-plans": "node scripts/shop-plans-check.mjs",
    "test:whatsapp": "node scripts/whatsapp-check.mjs",
    "whatsapp:templates": "node --no-warnings scripts/whatsapp-templates.mjs",
    "perf:trips": "node scripts/trips-check.mjs",
    "perf:report": "node scripts/perf-report.mjs",
    "db:check": "node --no-warnings scripts/db-check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mana_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mana_db --remote",
    "db:migrate:staging": "wrangler d1 migrations apply mana_db_staging --remote --env staging",
    "db:migrations:status": "wrangler d1 migrations list mana_db --remote",
    "db:reset:local": "node scripts/db-reset-local.mjs",
    "db:reset:staging": "node scripts/db-reset-local.mjs --staging",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "db:seed:staging": "node scripts/seed-demo.mjs --staging",
    "backup:restore": "node scripts/restore-backup.mjs",
    "support:reset-pin": "node scripts/reset-pin.mjs",
    "setup:business": "node scripts/setup-business.mjs",
    "db:seed:flats": "node scripts/seed-flats.mjs",
    "db:seed:menu": "node scripts/seed-menu.mjs",
    "data:post-offices": "node scripts/import-post-offices.mjs",
    "docs:price-list": "npx --yes tsx scripts/price-sheet.mts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.2.2",
    "@mana/db": "*",
    "@mana/domain": "*",
    "hono": "^4.4.0",
    "jose": "^5.2.4",
    "qrcode-generator": "^1.5.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240502.0",
    "india-pincode": "^2.5.9",
    "typescript": "^5.4.5",
    "wrangler": "^3.57.0"
  }
}
